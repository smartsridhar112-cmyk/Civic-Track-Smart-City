DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=civictrack
DB_USER=civic_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=3306

